    {
      "parameters": {
        "command": "=#!/bin/bash\n\n# Step 1: Define variables\nINPUT_JSON=\"$(n8n export:credentials --all --decrypted)\"\nSECRET_ID=\"{{ $('When Executed by Another Workflow').item.json.secret_id }}\"\n\nCRED_NAME=\"{{ $('When Executed by Another Workflow').item.json.cred_name }}\"\nJSON_PATH=\"{{ $('When Executed by Another Workflow').item.json.cred_path }}\"\nNEW_VALUE=$( echo '{{ JSON.stringify($('Get Secret Value').item.json) }}' | jq -r 'to_entries[] | .value')\n\n\n# Step 2: Extract and update\n\n# Convert JSON_PATH to jq path array\nJQ_PATH=$(echo \"$JSON_PATH\" | awk -F. '{for(i=1;i<=NF;i++) printf \"\\\"%s\\\",\", $i}' | sed 's/,$//')\n\n\n# Create a temp file using BusyBox-compatible mktemp\nTEMP_FILE=$(mktemp /tmp/tmp.XXXXXX)\n\n# Extract, update, and save to temp file\necho \"$INPUT_JSON\" | jq --arg name \"$CRED_NAME\" --argjson path \"[$JQ_PATH]\" --arg value \"$NEW_VALUE\" '\n  map(select(.name == $name))\n  | map(setpath($path; $value))\n' > \"$TEMP_FILE\"\n\n# Import\nn8n import:credentials --input=$TEMP_FILE\n\n# Remove the temp file\nrm \"$TEMP_FILE\""
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1952,
        992
      ],
